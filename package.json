{
  "name": "poultrypilot",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:api": "pnpm --filter @poultrypilot/api dev",
    "dev:web": "pnpm --filter @poultrypilot/web dev",
    "openapi": "pnpm --filter @poultrypilot/contracts openapi",
    "db:up": "docker compose up -d mongo",
    "db:down": "docker compose down",
    "db:shell": "docker compose exec mongo mongosh poultrypilot"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "type": "module"
}
