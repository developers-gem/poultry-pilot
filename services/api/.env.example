# Copy to services/api/.env (git-ignored) and fill in. Never commit .env.
NODE_ENV=development
APP_VERSION=0.1.0
HOST=0.0.0.0
PORT=4000
# Number of proxy hops to trust for client IPs (0 locally, 1 behind a load balancer)
TRUST_PROXY=0

# Local replica set from docker-compose.yml. directConnection lets a host-side client
# reach a replica set member advertised as localhost.
MONGODB_URI=mongodb://localhost:27017/poultrypilot?replicaSet=rs0&directConnection=true
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_MAX_POOL_SIZE=20
MONGODB_CONNECT_RETRIES=10
# Build indexes on startup (defaults to true outside production)
# MONGODB_AUTO_INDEX=true

# REQUIRED. Generate with:  openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_ISSUER=poultrypilot-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=10
REQUEST_BODY_LIMIT=1mb

# Comma-separated Google OAuth client IDs (web + Android + iOS). Empty disables Google sign-in.
GOOGLE_CLIENT_IDS=
APP_BASE_URL=http://localhost:5173

LOG_LEVEL=info
# json for production log pipelines, pretty for local reading
LOG_FORMAT=pretty
SHUTDOWN_TIMEOUT_MS=10000
OPENAPI_ENABLED=true
