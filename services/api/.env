# Copy to services/api/.env (git-ignored) and fill in. Never commit .env.
NODE_ENV=development
APP_VERSION=0.1.0
HOST=0.0.0.0
PORT=4000
# Number of proxy hops to trust for client IPs (0 locally, 1 behind a load balancer)
TRUST_PROXY=0

# Direct replica set connection string for Atlas (bypasses Windows Node.js querySrv ECONNREFUSED issue)
MONGODB_URI=mongodb://developers_db_user:cavcDgoftOhXXctW@ac-21yucvg-shard-00-00.ylgymfy.mongodb.net:27017,ac-21yucvg-shard-00-01.ylgymfy.mongodb.net:27017,ac-21yucvg-shard-00-02.ylgymfy.mongodb.net:27017/paultry_project?ssl=true&replicaSet=atlas-l9dtir-shard-0&authSource=admin
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_MAX_POOL_SIZE=20
MONGODB_CONNECT_RETRIES=10
# Build indexes on startup (defaults to true outside production)
# MONGODB_AUTO_INDEX=true

# REQUIRED. Generate with:  openssl rand -base64 48
JWT_ACCESS_SECRET=KpNnPBB+1W5uEeIpc/n347LwMFAAEPyuVPkr1otc/9EU2VI1
JWT_ISSUER=poultrypilot-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# A session (signed-in device) ends after this many days even if it keeps refreshing
SESSION_MAX_DAYS=90
# Lock an account for LOGIN_LOCK_MINUTES after this many consecutive wrong passwords
LOGIN_MAX_FAILED_ATTEMPTS=10
LOGIN_LOCK_MINUTES=15
# Uploaded photos (development). Use object storage in production.
MEDIA_DIR=./data/media
# News feeds imported every 6 hours for editorial review (titles, links and teasers only), e.g.
# NEWS_FEEDS=[{"url":"https://example.org/rss","source":"Example News","regionCode":"IN","category":"markets"}]
NEWS_FEEDS=[]

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=10
REQUEST_BODY_LIMIT=1mb

# Comma-separated Google OAuth client IDs (web + Android + iOS). Empty disables Google sign-in.
GOOGLE_CLIENT_IDS=
# Photos: an S3-compatible bucket (AWS S3, R2, MinIO, B2, Spaces). Unset: local disk at MEDIA_DIR (one instance,
# persistent volume). Credentials: AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY or the instance role. Keep the bucket private.
# S3_BUCKET=
S3_REGION=us-east-1
# S3_ENDPOINT=

# Weather: Open-Meteo's free API is non-commercial only. Set a key for commercial use (customer endpoint).
# OPEN_METEO_API_KEY=

# Outgoing email. REQUIRED in production (resets, invitations, verification, notification emails).
# e.g. smtps://user:password@smtp.example.com:465
# SMTP_URL=
EMAIL_FROM=PoultryPilot <no-reply@poultrypilot.app>

# Push notifications (Firebase Cloud Messaging). Unset: pushes are only logged.
# A Google service account with the Firebase Cloud Messaging API Admin role; paste its private key on one line with \n for new lines.
# FCM_PROJECT_ID=
# FCM_CLIENT_EMAIL=
# FCM_PRIVATE_KEY=
APP_BASE_URL=http://localhost:5173

LOG_LEVEL=info
# json for production log pipelines, pretty for local reading
LOG_FORMAT=pretty
SHUTDOWN_TIMEOUT_MS=10000
OPENAPI_ENABLED=true