{
  "name": "@poultrypilot/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsup",
    "start": "node --enable-source-maps --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "docs:data-dictionary": "tsx scripts/generate-data-dictionary.ts",
    "db:indexes": "tsx src/create-indexes.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@node-rs/argon2": "^2",
    "@poultrypilot/constants": "workspace:*",
    "@poultrypilot/contracts": "workspace:*",
    "@poultrypilot/types": "workspace:*",
    "@poultrypilot/validation": "workspace:*",
    "cors": "^2",
    "exceljs": "4.4.0",
    "express": "^5",
    "express-rate-limit": "^7",
    "google-auth-library": "^9",
    "helmet": "^8",
    "jose": "^5",
    "mongoose": "^8",
    "nodemailer": "^10.1.2",
    "pdfkit": "0.15.0",
    "pino": "^9",
    "pino-http": "^10",
    "uuid": "^11.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "0.13.5",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15"
  }
}
