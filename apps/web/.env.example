# Copy to apps/web/.env.local (git-ignored).
# Leave empty in development: requests go to /api on the Vite dev server, which proxies to the API.
# In production set it to the API origin, e.g. https://api.poultrypilot.example
VITE_API_BASE_URL=
# Where the Vite dev server forwards /api requests (development only)
API_PROXY_TARGET=http://localhost:4000
