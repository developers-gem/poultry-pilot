NODE_ENV=development
PORT=4000
# Transactions need a replica set: Atlas, or a local single-node replica set (see README)
MONGODB_URI=mongodb://localhost:27017/poultrypilot?replicaSet=rs0
JWT_ACCESS_SECRET=replace-with-a-random-string-of-at-least-32-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGINS=http://localhost:5173
GOOGLE_CLIENT_IDS=
APP_BASE_URL=http://localhost:5173
LOG_LEVEL=info
